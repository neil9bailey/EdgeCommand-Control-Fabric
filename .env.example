# EdgeCommand Control Fabric local runtime
APP_ENV=development
AUTH_MODE=development
API_GATEWAY_PORT=3101
WEB_CONSOLE_PORT=5174
VITE_API_BASE=http://localhost:3101

# Entra ID / JWT
# Production/API test mode:
# AUTH_MODE=entra_jwt_rs256
# Tenant and JWT details can be supplied directly or loaded from Azure Key Vault.
ENTRA_TENANT_ID=
ENTRA_EXPECTED_TENANT_ID=
ENTRA_EXPECTED_AUDIENCE=
ENTRA_EXPECTED_ISSUERS=
ENTRA_EXPECTED_ISSUER=
ENTRA_OIDC_DISCOVERY_URL=
ENTRA_JWKS_URI=
ENTRA_ROLE_CLAIM=roles
ENTRA_GROUP_TO_ROLE_JSON=
ENTRA_PRINCIPAL_TO_ROLE_JSON=

# Integration-test-only mode. Do not use this in production.
# AUTH_MODE=entra_jwt_hs256
ENTRA_JWT_HS256_SECRET=

# Shared Azure Key Vault secret source.
# Use the same DIIaC Key Vault by setting AZURE_KEY_VAULT_URL and, where needed,
# overriding EdgeCommand env names to the existing DIIaC secret names.
AZURE_KEY_VAULT_URL=
AZURE_KEY_VAULT_REQUIRED=false
AZURE_KEY_VAULT_OVERWRITE=false
AZURE_KEY_VAULT_REQUIRED_SECRET_ENV_NAMES=
AZURE_KEY_VAULT_SECRET_NAMES_JSON={}

# Secret-backed provider keys. Leave blank locally unless testing integrations.
EDGECOMMAND_INTERNAL_API_TOKEN=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
POSTMAN_API_KEY=
HOME_ASSISTANT_TOKEN=
MQTT_USERNAME=
MQTT_PASSWORD=

# Future remote connectivity placeholders.
LORAWAN_NETWORK_SERVER_URL=
LORAWAN_NETWORK_SERVER_TOKEN=
NBIOT_PROVIDER_MODE=simulated
