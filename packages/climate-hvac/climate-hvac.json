{
  "schemaVersion": "0.1.0",
  "tenant": "vendorlogic.io",
  "service": {
    "id": "climate-hvac-service",
    "name": "Climate And HVAC",
    "moduleId": "climate-hvac",
    "mode": "deterministic-local",
    "executionBoundary": "simulated-climate-command-plan-only",
    "defaultZoneId": "climate-zone-hall",
    "rule": "Climate commands may plan safe medium-risk setpoint changes locally; real adapters execute only after range, manual override, schedule, and audit checks."
  },
  "featureModule": {
    "moduleId": "climate-hvac",
    "state": "foundation",
    "buildStrategy": "feature-manifest-plus-service-plus-dashboard",
    "enabledBy": ["human_intent", "module_marketplace", "operator_dashboard"],
    "buildArtifacts": [
      "packages/climate-hvac/climate-hvac.json",
      "services/api-gateway/src/climateHvac.mjs",
      "apps/web-console ClimateHvacPanel",
      "api contracts and tests"
    ]
  },
  "policies": [
    {
      "id": "safe-setpoint-range",
      "name": "Safe Setpoint Range",
      "risk": "medium",
      "scope": ["thermostat", "temperature", "hvac_mode"],
      "requiresApproval": false,
      "requiresAudit": true,
      "minHeatC": 16,
      "maxHeatC": 23,
      "minCoolC": 18,
      "maxCoolC": 26,
      "message": "Setpoints outside safe heat/cool ranges are blocked before adapter execution."
    },
    {
      "id": "manual-override-first",
      "name": "Manual Override First",
      "risk": "medium",
      "scope": ["thermostat", "hvac_mode"],
      "requiresApproval": false,
      "requiresAudit": true,
      "message": "A thermostat with manual override active is held out of the command plan."
    },
    {
      "id": "humidity-comfort-guard",
      "name": "Humidity Comfort Guard",
      "risk": "low",
      "scope": ["humidity", "comfort_band"],
      "requiresApproval": false,
      "requiresAudit": true,
      "minHumidity": 35,
      "maxHumidity": 60,
      "message": "Humidity outside the comfort band is surfaced as evidence before mode changes."
    },
    {
      "id": "energy-reserve-eco",
      "name": "Energy Reserve Eco",
      "risk": "medium",
      "scope": ["eco_mode", "battery", "tariff"],
      "requiresApproval": false,
      "requiresAudit": true,
      "message": "Eco adjustments are preferred during reserve or tariff pressure unless comfort bounds would be breached."
    }
  ],
  "zones": [
    {
      "id": "climate-zone-hall",
      "siteId": "home-hq",
      "zoneId": "hall",
      "name": "Hall Comfort Core",
      "thermostatDeviceId": "dev-thermostat-hall-01",
      "sensorDeviceIds": ["dev-thermostat-hall-01"],
      "occupancyMode": "circulation",
      "comfortBand": { "heatMinC": 19, "heatMaxC": 21.5, "coolMinC": 22, "coolMaxC": 24.5 },
      "ecoSetpointC": 18,
      "awaySetpointC": 16.5,
      "frostSetpointC": 7,
      "priority": "primary"
    },
    {
      "id": "climate-zone-living",
