      "exampleIntent": "Hold EV charging if the battery reserve is at risk."
    },
    {
      "id": "intent-tariff-load-shift",
      "name": "Tariff load shifting",
      "keywords": ["tariff", "cheap", "shift", "window", "load"],
      "profileId": "profile-tariff-load-shift",
      "confidence": 0.88,
      "exampleIntent": "Shift flexible loads into the cheapest tariff window."
    },
    {
      "id": "intent-outage-critical-loads",
      "name": "Outage critical loads",
      "keywords": ["outage", "critical", "backup", "load", "power"],
      "profileId": "profile-outage-critical-loads",
      "confidence": 0.86,
      "exampleIntent": "If the grid is down, preserve battery for critical loads only."
    }
  ],
  "recentEnergyRuns": [
    {
      "id": "energy-run-20260510-001",
      "profileId": "profile-battery-reserve-guard",
      "status": "ready",
