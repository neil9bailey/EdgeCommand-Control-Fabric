  ],
  "intentRecipes": [
    {
      "id": "intent-certify-mqtt",
      "name": "Certify MQTT Adapter",
      "keywords": ["certify", "mqtt", "esphome", "test", "adapter"],
      "profileId": "cert-mqtt-esphome-foundation",
