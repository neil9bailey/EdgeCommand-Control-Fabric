{
  "schemaVersion": "0.1.0",
  "tenant": "vendorlogic.io",
  "service": {
    "id": "module-manifest-service",
    "name": "Module Manifest And Feature Flags",
    "moduleId": "module-marketplace",
    "mode": "deterministic-local",
    "executionBoundary": "plan-and-preview-only",
    "defaultEnvironment": "local-docker",
