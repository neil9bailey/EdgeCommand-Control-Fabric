      "packages/module-manifest/module-manifest.json",
      "services/api-gateway/src/moduleManifest.mjs",
      "apps/web-console ModuleManifestPanel",
      "api contracts and tests"
    ]
  },
  "flagStates": [
    { "id": "enabled", "name": "Enabled", "allowsRuntimeSurface": true, "allowsBuild": false, "requiresApproval": false },
    { "id": "discoverable", "name": "Discoverable", "allowsRuntimeSurface": false, "allowsBuild": true, "requiresApproval": false },
    { "id": "preview", "name": "Preview", "allowsRuntimeSurface": true, "allowsBuild": true, "requiresApproval": false },
